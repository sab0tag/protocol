# The app's address (CORS). Add http://localhost:5173 for local development.
ALLOWED_ORIGINS=https://protocol.beyondthesignal.to
# Photo recognition and «Меню на завтра»: a separate Anthropic key with a spend limit. Empty = photos off, sync still works.
ANTHROPIC_API_KEY=
PHOTO_MODEL=claude-opus-5-5
PHOTO_EFFORT=low
PHOTOS_PER_DAY=150
PHOTOS_PER_VAULT_PER_DAY=30
MENU_MODEL=claude-opus-5-5
MENU_EFFORT=medium
MENUS_PER_VAULT_PER_DAY=15
# Off-site copies of the nightly backups (the Storage Box of Харчоблок; same RCLONE_CONFIG_OFFSITE_* values)
PROTOCOL_BACKUP_REMOTE=
