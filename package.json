{
  "name": "protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "TZ=Europe/Kyiv vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "TZ=Europe/Kyiv playwright test",
    "eval:concierge": "VITE_API_URL=https://api.beyondthesignal.to vitest run --config vitest.eval.config.ts tests/eval/concierge.eval.ts",
    "eval:prescriptions": "VITE_API_URL=https://api.beyondthesignal.to TZ=Europe/Kyiv vitest run --config vitest.eval.config.ts tests/eval/prescriptions.eval.ts",
    "build:e2e": "VITE_API_URL=http://localhost:8099 vite build --outDir dist-e2e",
    "eval:dishes": "VITE_API_URL=https://api.beyondthesignal.to vitest run --config vitest.eval.config.ts tests/eval/dishes.eval.ts"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.51.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "yaml": "^2.6.1"
  }
}
